{
	"source": ["./tokens/**/*.json"],
	"parsers": ["json-parser"],
	"platforms": {
		"css": {
			"transforms": [
				"attribute/cti",
				"name/grammar",
				"dimension/grammar",
				"color/css",
				"fontFamily/css",
				"shadow/css/shorthand"
			],
			"buildPath": "./styles/",
			"files": [
				{
					"destination": "primitives.css",
					"format": "css/variables",
					"filter": "cssPrimitiveFilter",
					"options": {
						"selector": ":root"
					}
				},
				{
					"destination": "primitive-scale.css",
					"format": "css/variables",
					"filter": "cssPrimitiveScaleFilter",
					"options": {
						"selector": ":root"
					}
				},
				{
					"destination": "light.css",
					"format": "css/variables",
					"filter": "cssLightModeFilter",
					"options": {
						"selector": ":root",
						"outputReferences": true,
						"outputReferenceFallbacks": true
					}
				},
				{
					"destination": "dark.css",
					"format": "css/variables",
					"filter": "cssDarkModeFilter",
					"options": {
						"selector": ":root.dark, .dark",
						"outputReferences": true,
						"outputReferenceFallbacks": true
					}
				},
				{
					"destination": "spacing.css",
					"format": "css/variables",
					"filter": "cssSpacingFilter",
					"options": {
						"selector": ":root",
						"outputReferences": true,
						"outputReferenceFallbacks": true
					}
				},
				{
					"destination": "grid-spacing.css",
					"format": "css/variables",
					"filter": "cssGridFilter",
					"options": {
						"selector": ":root",
						"outputReferences": true,
						"outputReferenceFallbacks": true
					}
				},
				{
					"destination": "flow.css",
					"format": "custom/flow",
					"filter": "cssFlowFilter"
				},
				{
					"destination": "typography.css",
					"format": "custom/typography",
					"filter": "cssTypographyFilter"
				},
				{
					"destination": "shadows.css",
					"format": "css/variables",
					"filter": "shadowFilter",
					"options": {
						"selector": ":root"
					}
				}
			]
		},
		"web": {
			"transforms": ["attribute/cti", "name/grammar", "dimension/grammar", "color/css"],
			"buildPath": "./styles/",
			"files": [
				{
					"destination": "tw-extend/color.cjs",
					"format": "tw/css-variables",
					"filter": "twFilter"
				},
				{
					"destination": "tw-extend/spacing.cjs",
					"format": "tw/css-spacing-variables",
					"filter": "twSpacingFilter"
				},
				{
					"destination": "tw-extend/gridspacing.cjs",
					"format": "tw/css-grid-variables",
					"filter": "twGridFilter"
				},
				{
					"destination": "tw-extend/flow.cjs",
					"format": "tw/css-flow-variables",
					"filter": "twFlowFilter"
				}
			]
		},
		"ts": {
			"transformGroup": "js",
			"buildPath": "./styles/",
			"files": [
				{
					"destination": "js/color-tokens.js",
					"format": "custom/js",
					"filter": "jsFilter",
					"options": {
						"minify": true
					}
				}
			],
			"transforms": ["name/grammar"]
		},
		"docs": {
			"transformGroup": "js",
			"transforms": ["name/grammar"],
			"buildPath": "./docs/tokens/",
			"files": [
				{
					"destination": "tokens.js",
					"format": "custom/docs"
				}
			]
		}
	}
}
