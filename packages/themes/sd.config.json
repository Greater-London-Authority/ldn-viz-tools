{
	"source": ["./tokens/lcd-ds.tokens.json"],
	"parsers": ["json-parser"],
	"platforms": {
		"css": {
			"transforms": [
				"attribute/cti",
				"name/grammar",
				"dimension/grammar",
				"color/css",
				"fontFamily/css",
				"shadow/css/shorthand"
			],
			"buildPath": "./styles/",
			"files": [
				{
					"destination": "reset.css",
					"format": "css/reset"
				},
				{
					"destination": "tokens.css",
					"format": "css/tokens"
				},
				{
					"destination": "system.css",
					"format": "css/system"
				},
				{
					"destination": "index.css",
					"format": "css/index"
				}
			]
		},
		"web": {
			"transforms": ["attribute/cti", "name/grammar", "dimension/grammar", "color/css"],
			"buildPath": "./styles/",
			"files": [
				{
					"destination": "tw-extend/color.cjs",
					"format": "tw/css-variables",
					"filter": "twFilter"
				},
				{
					"destination": "tw-extend/spacing.cjs",
					"format": "tw/css-spacing-variables",
					"filter": "twSpacingFilter"
				},
				{
					"destination": "tw-extend/gridspacing.cjs",
					"format": "tw/css-grid-variables",
					"filter": "twGridFilter"
				},
				{
					"destination": "tw-extend/flow.cjs",
					"format": "tw/css-flow-variables",
					"filter": "twFlowFilter"
				}
			]
		},
		"ts": {
			"transformGroup": "js",
			"buildPath": "./styles/",
			"files": [
				{
					"destination": "colors.js",
					"format": "custom/js",
					"filter": "jsFilter",
					"options": {
						"minify": true
					}
				}
			],
			"transforms": ["name/grammar"]
		},
		"docs": {
			"transformGroup": "js",
			"transforms": ["name/grammar"],
			"buildPath": "./docs/tokens/",
			"files": [
				{
					"destination": "tokens.js",
					"format": "custom/docs"
				}
			]
		}
	}
}
