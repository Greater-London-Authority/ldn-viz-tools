/* Write your global styles here, in PostCSS syntax */
@import '@ldn-viz/themes/index.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

html {
	scroll-behavior: smooth;
}

html.disable-smooth-scroll {
	scroll-behavior: auto;
}

/* [id] {
	scroll-margin-top: 66px;
} */

@layer base {
	code[data-theme='github-dark-dimmed'] {
		display: flex !important;
		flex-direction: column;
	}

	[data-rehype-pretty-code-figure] {
		@apply !my-3;
		@apply border border-color-border-wash;
		@apply overflow-auto;
	}

	[data-theme='github-dark-dimmed'] {
		@apply !px-2;
		background-color: #13181cff !important;
		color: var(--color-static-white) !important;
	}
}

@layer components {
	.ldn-viz-sidebar-toggle {
		@apply hidden;
	}
}
